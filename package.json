{
  "name": "riffit",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @riffit/web",
    "build": "npm run build --workspace @riffit/web",
    "typecheck": "npm run typecheck --workspace @riffit/web",
    "test:wordpress": "node tests/run-wordpress.mjs",
    "stage:spacefast": "node scripts/stage-source.mjs",
    "test:browser:backend": "node tests/serve-browser.mjs",
    "package:wordpress": "node scripts/package-wordpress.mjs",
    "export:starter": "node scripts/export-starter.mjs",
    "test:http": "node tests/http-routes.mjs",
    "prepare:public": "node scripts/prepare-public-repo.mjs"
  },
  "devDependencies": {
    "@wp-playground/cli": "3.1.61"
  },
  "overrides": {
    "qs": "6.17.1",
    "postcss": "8.5.32",
    "glob": "14.0.3",
    "minimatch": "11.0.3"
